<Window x:Class="BudgetWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BudgetWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition Width="4*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Button Name="DashboardButton" Click="DashboardButton_Click" Height="200">Dashboard</Button>
            <Button Name="ManageIndividualBillsButton" Click="ManageIndividualBillsButton_Click" Height="200">Manage Individual Bills</Button>
            <Button Name="ManageRecurringBillsButton" Click="ManageRecurringBillsButton_Click" Height="200">Manage Recurring Bills</Button>
        </StackPanel>
        <Canvas Grid.Column="1" Name="MainContentContainer"></Canvas>
    </Grid>
</Window>
