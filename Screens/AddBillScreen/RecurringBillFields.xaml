<UserControl x:Class="BudgetWPF.Screens.AddBillScreen.RecurringBillFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BudgetWPF.Screens.AddBillScreen"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
        <Grid Name="DefaultFieldGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
            </Grid.RowDefinitions>
            <!-- Labels -->
            <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=Recurring_StartDatePicker}">Start Date:</Label>
            <Label Grid.Column="2" Grid.Row="1" Target="{Binding ElementName=Recurring_EndDatePicker}">End Date:</Label>
            <Label Name="Recurring_WeeklyDayLabel" Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=Recurring_WeeklyDay}">on...</Label>
            <Label Name="Recurring_MonthlyDayLabel" Grid.Column="0" Grid.Row="0" Target="{Binding ElementName=Recurring_MonthlyDay}">on the...</Label>
            <!-- Fields -->
            <!-- START: Recurring reference fields -->
            <ComboBox Name="Recurring_WeeklyDayComboBox" Grid.Column="1" Grid.Row="0"></ComboBox>
            <ComboBox Name="Recurring_MonthlyDayComboBox" Grid.Column="1" Grid.Row="0"></ComboBox>
            <TextBlock Name="Recurring_FirstInstanceOnStartDateVerbiage" Grid.Column="1" Grid.Row="0">First instance will be made on the "Start Date" chosen below</TextBlock>
            <!-- END: Recurring reference fields -->
            <DatePicker Name="Recurring_StartDatePicker" Grid.Column="1" Grid.Row="1" Width="120" HorizontalAlignment="Left"></DatePicker>
            <DatePicker Name="Recurring_EndDatePicker" Grid.Column="3" Grid.Row="1"></DatePicker>
        </Grid>
</UserControl>
