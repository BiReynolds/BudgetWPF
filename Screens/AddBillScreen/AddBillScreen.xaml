<UserControl x:Class="BudgetWPF.Screens.AddBillScreen.AddBillScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BudgetWPF.Screens.AddBillScreen"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Style="{StaticResource HeaderStyle}">Add Bill or Income</TextBlock>
        <Grid Name="DefaultFieldGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
            </Grid.RowDefinitions>
            <!-- Labels -->
            <Label Grid.Column="0" Grid.Row="0"  Target="{Binding ElementName=NameTextBox}">Name: </Label>
            <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=AmountTextBox}">Amount: </Label>
            <Label Grid.Column="2" Grid.Row="1" Target="{Binding ElementName=TypeComboBox}">Type:</Label>
            <Label Grid.Column="0" Grid.Row="2">Recurs...</Label>
            <!-- Fields -->
            <TextBox Name="NameTextBox" Grid.Column="1" Grid.Row="0" MaxLength="50" Width="200" HorizontalAlignment="Left"></TextBox>
            <TextBox Name="AmountTextBox" Grid.Column="1" Grid.Row="1" Width="50" HorizontalAlignment="Left"
                PreviewTextInput="AmountTextBox_Preview"></TextBox>
            <ComboBox Name="TypeComboBox" Grid.Column="3" Grid.Row="1" Width="100" HorizontalAlignment="Left">
                <ComboBoxItem>Bill</ComboBoxItem>
                <ComboBoxItem>Income</ComboBoxItem>
            </ComboBox>
            <ComboBox Name="RecurringTypeComboBox" Grid.Column="1" Grid.Row="2" Width="200" HorizontalAlignment="Left" SelectionChanged="RecurringTypeComboBox_SelectionChanged"></ComboBox>
        </Grid>
        <local:OneTimeBillFields x:Name="OneTimeBillFieldData" Visibility="Collapsed"></local:OneTimeBillFields>
        <local:RecurringBillFields x:Name="RecurringBillFieldData" Visibility="Collapsed"></local:RecurringBillFields>
        <Button>Submit</Button>
    </StackPanel>
</UserControl>
