<UserControl x:Class="BudgetWPF.Screens.EditRecurringBillScreen.EditRecurringBillScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BudgetWPF.Screens.EditRecurringBillScreen"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Style="{StaticResource HeaderStyle}">Add Bill or Income</TextBlock>
        <Grid Name="DefaultFieldGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
            </Grid.RowDefinitions>
            <!-- Labels -->
            <Label Grid.Column="0" Grid.Row="0"  Target="{Binding ElementName=NameTextBox}">Name: </Label>
            <Label Grid.Column="0" Grid.Row="1" Target="{Binding ElementName=AmountTextBox}">Amount: </Label>
            <Label Grid.Column="2" Grid.Row="1" Target="{Binding ElementName=TypeComboBox}">Type:</Label>
            <Label Grid.Column="0" Grid.Row="2">Recurs...</Label>
            <Label Grid.Column="0" Grid.Row="4" Target="{Binding ElementName=Recurring_StartDatePicker}">Start Date:</Label>
            <Label Grid.Column="2" Grid.Row="4" Target="{Binding ElementName=Recurring_EndDatePicker}">End Date:</Label>
            <Label Name="Recurring_WeeklyDayLabel" Grid.Column="0" Grid.Row="3" Target="{Binding ElementName=Recurring_WeeklyDay}">on...</Label>
            <Label Name="Recurring_MonthlyDayLabel" Grid.Column="0" Grid.Row="3" Target="{Binding ElementName=Recurring_MonthlyDay}">on the...</Label>
            <!-- Fields -->
            <TextBox Name="NameTextBox" Grid.Column="1" Grid.Row="0" MaxLength="50" Width="200" HorizontalAlignment="Left" Text="{Binding Mode=TwoWay, Path=Name}"></TextBox>
            <TextBox Name="AmountTextBox" Grid.Column="1" Grid.Row="1" Width="50" HorizontalAlignment="Left"
                Style="{StaticResource TextBoxWithError}" PreviewTextInput="AmountTextBox_Preview">
            </TextBox>
            <ComboBox Name="TypeComboBox" Grid.Column="3" Grid.Row="1" Width="100" HorizontalAlignment="Left"></ComboBox>
            <ComboBox Name="RecurringTypeComboBox" Grid.Column="1" Grid.Row="2" Width="200" HorizontalAlignment="Left"></ComboBox>
            <!-- START: Recurring reference fields -->
            <ComboBox Name="Recurring_WeeklyDayComboBox" Grid.Column="1" Grid.Row="3"></ComboBox>
            <ComboBox Name="Recurring_MonthlyDayComboBox" Grid.Column="1" Grid.Row="3"></ComboBox>
            <TextBlock Name="Recurring_FirstInstanceOnStartDateVerbiage" Grid.Column="1" Grid.Row="3">First instance will be made on the "Start Date" chosen below</TextBlock>
            <!-- END: Recurring reference fields -->
            <DatePicker Name="Recurring_NextDueDatePicker" Grid.Column="1" Grid.Row="4" Width="120" HorizontalAlignment="Left"></DatePicker>
            <DatePicker Name="Recurring_EndDatePicker" Grid.Column="3" Grid.Row="4"></DatePicker>
        </Grid>
        <Button Click="Submit_Click">Submit</Button>
    </StackPanel>
</UserControl>